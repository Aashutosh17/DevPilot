# Copy to .env and fill in real values. .env is git-ignored.
# No quotes around values: Spring reads .env as a .properties file.

# Database
POSTGRES_DB=devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot

# LLM provider (any OpenAI-compatible API). Defaults: Google Gemini free tier.
# Free Gemini API key: https://aistudio.google.com/apikey (don't enable billing on that project).
OPENAI_API_KEY=your-gemini-api-key
# Optional overrides. Defaults shown. To use OpenAI (paid) instead, set:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_CHAT_MODEL=gpt-4o-mini
#   OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# and put your OpenAI key in OPENAI_API_KEY. Re-index repos after switching embedding models.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_CHAT_MODEL=gemini-3.5-flash-lite
# OPENAI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Encrypts GitHub access tokens stored in the database.
# Password: any long random string. Salt: hex string, e.g. output of `openssl rand -hex 8`.
TOKEN_ENCRYPTOR_PASSWORD=change-me-to-a-long-random-string
TOKEN_ENCRYPTOR_SALT=deadbeefcafebabe

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Optional: portfolio demo mode (see DEPLOY.md) ----
# Visitors get a "Try the live demo" button (no GitHub needed) and can only chat
# with the preset repos. Only the admin usernames below can sync and index.
DEMO_MODE=false
DEMO_ADMIN_GITHUB_USERNAMES=your-github-username
DEMO_REPOS=your-github-username/DevPilot

# ---- Production-only settings (set on Render / Vercel, not needed locally) ----
# Backend (Render):
#   GITHUB_REDIRECT_URI=https://<your-app>.vercel.app/login/oauth2/code/github
#   GITHUB_OAUTH_SCOPES=read:user
#   FRONTEND_URL=https://<your-app>.vercel.app
#   CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
#   SESSION_COOKIE_SECURE=true
#   OPENAI_BASE_URL / OPENAI_CHAT_MODEL / OPENAI_EMBEDDING_MODEL / EMBEDDING_DIMENSIONS (see above)
# Frontend (Vercel):
#   BACKEND_URL=https://<your-service>.onrender.com   (turns on the same-origin proxy)
